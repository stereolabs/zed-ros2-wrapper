# © 2026, Cargo Robotics
# Jetson (L4T) only: ZED SDK from l4t{major}.{minor}/jetsons + zed-opencv-calibration (plain CMake).
# Build context must be this directory. See ./calibrate_virtual_stereo_pair.sh build

ARG L4T_MAJOR=35
ARG L4T_MINOR=4
ARG L4T_PATCH=1
ARG IMAGE_NAME=dustynv/l4t-pytorch:r${L4T_MAJOR}.${L4T_MINOR}.${L4T_PATCH}

FROM ${IMAGE_NAME}

ARG L4T_MAJOR=35
ARG L4T_MINOR=4
ARG L4T_PATCH=1
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=1
ARG ZED_SDK_PATCH=0
ARG CUSTOM_ZED_SDK_URL=""

ENV DEBIAN_FRONTEND=noninteractive

ENV ZED_SDK_URL=${CUSTOM_ZED_SDK_URL:-"https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons"}

RUN apt-get update || true && apt-get install -y --no-install-recommends curl ca-certificates && \
  rm -rf /var/lib/apt/lists/*

RUN echo "ZED SDK (calibration image): ${ZED_SDK_URL}"
RUN if [ "$(curl -L -I "${ZED_SDK_URL}" -o /dev/null -s -w '%{http_code}\n' | head -n 1)" = "200" ]; then \
  echo "ZED SDK URL OK."; \
  else \
  echo "ZED SDK URL did not return HTTP 200. Check L4T_MAJOR/MINOR match your JetPack line. Override with --build-arg CUSTOM_ZED_SDK_URL=..." >&2; \
  exit 1; \
  fi

ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Do not install libopencv-dev here: dustynv / Jetson AI Lab bases ship their own OpenCV
# (e.g. libopencv_*_arm64.debs) and apt's Ubuntu/JP repo mix causes dpkg file conflicts.
# Use OpenCV from the base image + ZED SDK dependency layout for find_package(OpenCV).
# The ZED .run installer shells out to `file` for arch / payload checks. If it is missing,
# the script tries `apt install file`, often fails in minimal images, then mis-detects
# and prints a bogus "not compatible with ARM" message.
RUN apt-get update && apt-get install -y --no-install-recommends \
  lsb-release wget less udev sudo build-essential cmake pkg-config \
  python3 python3-pip \
  file \
  libpng-dev libgomp1 zstd \
  freeglut3-dev libglew-dev libgl1-mesa-dev \
  libusb-1.0-0-dev \
  libyaml-cpp-dev \
  gnupg2 curl \
  && rm -rf /var/lib/apt/lists/*

RUN echo "# R${L4T_MAJOR} (release), REVISION: ${L4T_MINOR}" > /etc/nv_tegra_release && \
  wget -q --no-check-certificate -O /tmp/ZED_SDK_Linux_JP.run "${ZED_SDK_URL}" && \
  chmod +x /tmp/ZED_SDK_Linux_JP.run && \
  /tmp/ZED_SDK_Linux_JP.run silent && \
  rm -rf /usr/local/zed/resources/* && \
  rm -f /tmp/ZED_SDK_Linux_JP.run

WORKDIR /opt/zed-opencv-calibration
COPY . ./

RUN cmake -B build -S . \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_LIBRARY_PATH=/usr/local/cuda/lib64/stubs \
  -DCMAKE_CXX_FLAGS="-Wl,--allow-shlib-undefined" && \
  cmake --build build --parallel "$(nproc)"

ENV PATH="/opt/zed-opencv-calibration/build/stereo_calibration:/opt/zed-opencv-calibration/build/stereo_reprojection_viewer:${PATH}"

WORKDIR /root
CMD ["/bin/bash"]
